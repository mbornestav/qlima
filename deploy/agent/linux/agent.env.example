# Optional environment overrides for the HeatBridge Agent (systemd EnvironmentFile).
# Install as /etc/heatbridge/agent.env (root-owned, mode 0600).
#
# Development phase only: the agent reaches the server through an SSH reverse tunnel on 127.0.0.1,
# which requires DOTNET_ENVIRONMENT=Development together with "AllowInsecureLoopback": true in agent.json.
# Remove this line once the server is reachable over wss://.
DOTNET_ENVIRONMENT=Development

# Do NOT put the agent secret here; use: sudo heatbridge-agentctl new-secret
