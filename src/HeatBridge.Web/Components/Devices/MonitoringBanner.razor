@implements IDisposable
@using HeatBridge.Web.Monitoring
@inject MonitoringStore Store
@inject MonitoringHealth Health

@if (_error is not null || Health.StorageError is not null)
{ <div class="notice danger" role="alert">@(Health.StorageError ?? _error)</div> }
@if (Health.EmailError is not null)
{ <div class="notice danger" role="alert">@Health.EmailError <a href="/notifications">E-postinställningar</a></div> }
@foreach (var warning in _warnings) { <div class="notice danger" role="alert">@warning</div> }

@code {
    private IReadOnlyList<string> _warnings = [];
    private string? _error;
    private readonly CancellationTokenSource _stop = new();
    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _ = Watch();
    }
    private async Task Refresh()
    {
        try { _warnings = await Task.Run(Store.ActiveWarnings); _error = null; }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException or UnauthorizedAccessException or InvalidOperationException or System.Text.Json.JsonException)
        { _error = "Övervakningen kan inte läsa sparade larm."; }
    }
    private async Task Watch()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try { while (await timer.WaitForNextTickAsync(_stop.Token)) await InvokeAsync(async () => { await Refresh(); StateHasChanged(); }); }
        catch (OperationCanceledException) { }
    }
    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
}
