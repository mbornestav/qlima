<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>HeatBridge.Web</RootNamespace>
    <Version>0.2.0</Version>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Development-only secrets such as agent SecretHash values are kept in user secrets (see README). -->
    <UserSecretsId>heatbridge-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeatBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeatBridge.Core\HeatBridge.Core.csproj" />
    <ProjectReference Include="..\HeatBridge.EspHome\HeatBridge.EspHome.csproj" />
    <ProjectReference Include="..\HeatBridge.Protocol\HeatBridge.Protocol.csproj" />
  </ItemGroup>

</Project>
